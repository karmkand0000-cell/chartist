# Copy to .env and fill in
DATABASE_URL=            # postgres://user:pass@host:5432/db  (empty = embedded PGlite in ./data)
JWT_SECRET=              # long random string (openssl rand -hex 32)
ADMIN_EMAIL=admin@chartist.in
ADMIN_PASSWORD=          # first admin login (2FA OTP is printed in server logs until SMS is configured)
CORS_ORIGINS=*           # comma-separated origins allowed to call the API (your web/app origins)
BROKER_NAME=Chartist Securities
SEBI_REG=                # your SEBI registration number once licensed
OTP_DELIVERY=log         # log | smtp  (SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM)
FEED_ADAPTER=simulator   # simulator | yahoo (free delayed reference prices)
EXCHANGE_ADAPTER=simulator
MARKET_MODE=auto
DEV_MODE=0               # 1 = show OTPs in API responses (never in production)
